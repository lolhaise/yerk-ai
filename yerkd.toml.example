# An example yerkd.toml, the settings of yerkd, the program that stays running, carries every room's messages and runs
# is a placeholder.

[discord]
token_file = "secrets/discord.token"     # the bot's token, a file only you can read (0600)
owner = "<your Discord user id>"          # the owner, answered in every room

[watch]
# Other assistants' Discord user ids. In a channel a room watches (`watch` in rooms.toml), their messages go in that room's
# day log under their own label once they stop changing, so the room can read what was already said there; never answered.
# Their files, there or in the room's own channel, are saved in the room's work/inbox as a person's are.
assistants = ["<the other assistant's bot user id>"]

[location]
# Where the owner is, from a phone's fixes (docs/GUIDE.md: The private folder): the `place` part in an owner room's messages and
# `yerk location day`. Both files are only read, and nothing goes to the network. No table, no part.
file = "<the fixes file: one JSON fix a line, ts_iso, lat, lon, speed_mps>"
places = "<the named places: {\"places\": [{\"label\", \"lat\", \"lon\", \"radius_m\"}]}>"
stale_after = "3h"                       # no part when the newest fix is older than this

[needs]
# What a room could not do, filed with its `need` tool, is built by `yerk needs build DAY N`: a builder worker with the
# need as its brief, its card in the machine room. Every key is optional.
account = "<an account name from accounts.toml>"   # the account builders run on; default: [curate] account, else the workers' pick
cap_minutes = 60                                  # a builder's minutes before it is stopped

[imessage]
# The `text` tool's way to the owner's Mac (docs/GUIDE.md: Texts in your name): ssh to `host`, then socat to the bridge's socket
# there. Each text is held in the room for the owner's word first. No table, no texts: the tool says no Mac is set up.
host = "<the Mac's ssh host, reached from this machine with a key>"
socket = "<the bridge's socket on the Mac>"
service = "auto"                         # imessage, sms or auto: iMessage where the person has it, else SMS

[limits]
# One switch for every character budget in budgets.toml (docs/budgets.md: Uncapped); false, or no table, is the capped install.
uncapped = false     # true: every character budget in budgets.toml reads as unlimited for what is sent; the numbers stay as measurements
