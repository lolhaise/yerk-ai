# An example rooms.toml, the file that lists your rooms: one [rooms.NAME] table per room, with its chat, its accounts,
# Paths are relative to the private folder.

# [defaults]: the one tool set every owner room carries, declared once, so the rooms share one way of doing things. It holds
# allow, worker_addons and mcp.<name> tables only (each room keeps its own sandbox); any other key stops the start. A room's
# own allow, worker_addons or mcp.<name> table replaces that default whole, and allow_remove = [...] in a room drops named tools from the allow
# it inherits. A room whose privacy is not owner inherits nothing. {room} in a server's args and env is the room's name.
# `yerk doctor` names an owner room that misses a default tool or carries its own copy of one. The set below is one
# install's: the web plug-in and hands, a second assistant's reach on the machine over MCP (owner rooms only).
# Web reach (docs/GUIDE.md "Web reach"): the plug-in in plugins/web, run `npm ci --omit=dev` there once. Its keys are files in
# the private folder's secrets/, each optional; with none it reads pages from this machine and searches keyless engines.
# [defaults]
# allow = ["mcp__web-ladder__web_fetch", "mcp__web-ladder__web_search", "mcp__web-ladder__web_research", "mcp__web-ladder__web_research_result", "mcp__hands__browser", "mcp__hands__desktop", "mcp__hands__mac", "mcp__hands__mail", "mcp__hands__discord", "mcp__web-ladder__web_image"]
# worker_addons = ["mcp__example-addon__read"]   # the add-on tools every worker started from an owner room gets too (a tool, or a server's name for its tools allow names); skipped when allow has it not or its table passes a credential
# [defaults.mcp.web-ladder]
# type = "stdio"
# command = "node"
# args = ["/path/to/yerk-ai/plugins/web/server.mjs", "--private", "/path/to/your/private/folder", "--state", "/path/to/your/state/folder", "--room", "{room}"]
# timeout = 180000           # ms, a hard limit per call; the fetch ladder stops itself at 140 s
# alwaysLoad = true          # its tools in the prompt from the start
# [defaults.mcp.hands]
# type = "stdio"
# command = "node"
# args = ["/path/to/hands-mcp/server.mjs"]
# env = { YERK_ROOM = "{room}" }   # the room the plug-in checks in rooms.toml; owner rooms only, the plug-in refuses any other room
# timeout = 120000           # ms, a hard limit per call; a browser call lifts and arms the brake, about 15 s
# alwaysLoad = true

[rooms.example-room]
channel = "discord:CHANNEL_ID"
accounts = ["one", "two"]     # tried in this order, then the rest of accounts.toml; the settings tool or /model can put the room on one account first
model = "claude-fable-5-1"     # also what a turn runs on, saying so on its card, while every account is out of the model the settings tool or /model put the room on
tools = ["Read", "Grep", "Glob"]
privacy = "owner"
timezone = "UTC"
persona = "persona.md"
rulebook = "rulebook.md"
voice = "rooms/example-room.md"
pinned_memory = "memory/pinned.md"
daily_notes = "memory/daily"
recall_days = 2
open_loops = "memory/open-loops.md"
# effort = "high"             # passed as --effort; unset: the model's own default
# compact_window = 250000     # tokens the session keeps before Claude Code compacts; unset: budgets.toml [session]; 0: the model's own
# idle_compact_at = 0.7       # a session at this share of that window or more is compacted between turns; unset: budgets.toml; 0: never
# idle_compact_after = 25     # ... once the room has had no turn for this many minutes; unset: budgets.toml [session]
# allow = ["Bash", "Write"]   # permission rules beyond Read; add the tool to `tools` too. The gates run first
# also = ["~/notes"]          # only these of yerkd.toml's [memory] also roots reach its recall, read_memory and names; unset: all
# sealed = true               # in Yerk's own tree, its own room's lines only: no other room's lines, notes, facts or rules
# people = [USER_ID]         # Discord user ids answered in this room besides the owner (sender "person"); unset: the owner only.
#                             # Needs a privacy other than owner: an owner room reads the owner's whole memory
# shell = "trusted"          # a room with people that runs the owner rooms' tools, as tools = ["Read", "Grep", "Glob", "Bash", "Write", "Edit"]:
#                             # its shell inside the daemon's wall (`yerk explain trusted`), Write and Edit on its layer and work folder only;
#                             # its [rooms.NAME.sandbox] may add filesystem.denyRead, filesystem.denyWrite and the network allowlist, no other key
# card = "count"              # a room with people: its holding line and a step count, never a step; unset or "steps": an owner room's card, one row per step
thinking_panel = false        # owner-only rooms: a "thinking" line on the card (costs about 5 s a reply)
# allow_remove = ["mcp__hands__mail"]   # tools this room does without, out of the allow it inherits from [defaults]
# worker_addons = []         # the room's own add-on tools every worker started from it gets; replaces [defaults]' whole, [] for none

[rooms.example-quiet]
channel = "discord:CHANNEL_ID"
accounts = ["two", "one"]
model = "claude-fable-5-1"
tools = ["Read"]
privacy = "owner"
timezone = "UTC"
persona = "persona.md"
rulebook = "rulebook.md"
voice = "rooms/example-quiet.md"
pinned_memory = "memory/pinned.md"
daily_notes = "memory/daily"
recall_days = 1
