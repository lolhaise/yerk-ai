# An example accounts.toml, the file that names the Claude Code accounts Yerk AI may use: copy it to your private
# One line per account: its name, its Claude Code config folder, its order (lower is tried
# first), and optionally its one-year token file (relative to this folder; the default is
# secrets/claude-<name>.token, written by `yerk accounts token NAME`). Adding or removing an
# account is one line here and nothing else.

[accounts]
one = { config_dir = "~/.claude", order = 1 }
two = { config_dir = "~/.claude-two", order = 2 }
