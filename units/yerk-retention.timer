# Every day at 04:20 local time, after the rooms' processes have gone idle and before the 06:30
# morning diff that says what it moved; a night the box was off runs once when it is back.
[Unit]
Description=Yerk AI retention sweep at 04:20

[Timer]
OnCalendar=*-*-* 04:20:00
Persistent=true

[Install]
WantedBy=timers.target
