# yerk-index: the memory index in its own process (DESIGN 5). Installed by copying this file to
# ~/.config/systemd/user/ and `systemctl --user enable --now yerk-index.service`. It reads
# [memory] in the private yerkd.toml for its roots; the index file is <state>/memory/index.sqlite.
# Low CPU and idle IO priority so index work never competes with the daemon serving rooms.
#
# Memory is mostly the vectors meaning search keeps here: one float16 matrix grown in blocks of 16,384
# vectors, 8.3M a block at 256 dimensions (16,384 x (2 x 256 + 20 hash) bytes = 8,716,288). On 2026-10-21,
# after five new roots, it held 862,135 vectors in 53 blocks, 441M; beside them 109M stayed resident and
# 86M sat cold in swap (the interpreter, numpy, SQLite, load leftovers; MALLOC_ARENA_MAX=2 keeps them to two
# glibc arenas), and the kernel held 9M. A 450M cap under that kept the unit reclaiming and swapping (600M in
# swap; meaning search took 3.5 to 8.2 s, past the recall's 5 s wait); 600M served warm searches but the first
# after each backfill scan (300M of file pages) took 3.5 to 4.7 s; 1G never reclaimed. The rule: MemoryHigh =
# 256M + 8.3M per block of 16,384 vectors, the 256M being the 109M, the 86M (a new process holds it resident
# until reclaimed), the 9M, 25M of file pages and 25M for searches at once (embeddings.HIGH_BASE); `yerk doctor`
# says when the vector count passes it. 800M covers 65 blocks (1,064,960 vectors); past MemoryHigh the kernel
# reclaims and slows the unit, and kills nothing.
[Unit]
Description=Yerk AI memory index (FTS5 over the private memory tree)

[Service]
Type=simple
Environment=YERK_PRIVATE=%h/yerk-private
Environment=YERK_STATE=%h/.local/state/yerk
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
WorkingDirectory=%h/yerk-ai
ExecStart=%h/yerk-ai/.venv/bin/python -m yerk_ai.memindex
Restart=on-failure
RestartSec=10s
Nice=10
IOSchedulingClass=idle
MemoryHigh=800M

[Install]
WantedBy=default.target
