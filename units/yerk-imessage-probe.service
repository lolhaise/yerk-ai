# The iMessage inbound check (Layer 8): reads the newest rows of each iMessage room's chat from the
# Mac's bridge, read only, and checks each reached the inbound ledger; it never sends. Installed by
# copying both files to ~/.config/systemd/user/ and `systemctl --user enable --now
# yerk-imessage-probe.timer`. Set YERK_PRIVATE and YERK_STATE below.
[Unit]
Description=Yerk AI iMessage inbound check (read only, never sends)

[Service]
Type=oneshot
Environment=YERK_PRIVATE=%h/yerk-private
Environment=YERK_STATE=%h/.local/state/yerk
ExecStart=%h/yerk-ai/.venv/bin/yerk probe imessage
TimeoutStartSec=120
